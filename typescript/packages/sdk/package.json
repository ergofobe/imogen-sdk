{
  "name": "@imogen/sdk",
  "version": "0.2.0",
  "type": "module",
  "description": "TypeScript client for the imogen photo library API",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ergofobe/imogen-sdk.git",
    "directory": "typescript/packages/sdk"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "keywords": [
    "imogen",
    "photos",
    "self-hosted",
    "api-client"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "bun run build",
    "test": "bun test",
    "npm-publish": "npm publish --access public"
  },
  "dependencies": {
    "@imogen/shared": "0.2.0"
  }
}
